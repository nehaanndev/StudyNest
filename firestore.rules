rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own StudyNest data.
    // Works for anonymous users, email/password users, and Google Sign-In users
    // because Firebase Auth always provides a uid regardless of sign-in method.
    match /users/{userId}/studyNest/state {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
